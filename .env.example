# OpenAI — ключ для інтерпретації та TTS
OPENAI_API_KEY=sk-...

# Секрет для запитів від Streamer.bot (придумай довгий рандомний рядок)
API_SECRET=change-me-to-a-long-random-string

# Порт (Render підставить свій автоматично)
PORT=3000

# Опційно: публічний URL сервера (для overlay, якщо не визначається автоматично)
# PUBLIC_BASE_URL=https://your-app.onrender.com

# OpenAI моделі (дешеві за замовчуванням)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Чи дозволяти перевернуті карти (true/false)
ALLOW_REVERSED=true
